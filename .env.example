# Root Environment Example for SIH26262 ApproFlow
# --------------------------------------------------

# Backend Settings
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
FRONTEND_ORIGIN=http://localhost:5173
JOB_SECRET=change-me-long-random-string
ALLOW_DEV_AUTH=false
NOTIFY_EMAIL_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_USER=user@example.com
SMTP_PASSWORD=secret
TZ_DISPLAY=Asia/Kolkata
SLA_USE_WORKING_DAYS=false
DOCUMENT_EXPIRING_DAYS=30
REMINDER_OFFSETS=7,3,1
DELAY_MODEL_PATH=models/delay_model.joblib

# Frontend Settings (public)
VITE_API_URL=http://localhost:8000/api/v1
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_USE_MOCKS=true
VITE_RISK_TAG_THRESHOLD=0.7
