SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
FRONTEND_ORIGIN=http://localhost:5173
JOB_SECRET=change-me-long-random-string
# Local dev only: lets requests without a token act as a dev admin. Never true when deployed.
ALLOW_DEV_AUTH=false
NOTIFY_EMAIL_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_USER=user@example.com
SMTP_PASSWORD=secret
TZ_DISPLAY=Asia/Kolkata
SLA_USE_WORKING_DAYS=false
DOCUMENT_EXPIRING_DAYS=30
REMINDER_OFFSETS=7,3,1
DELAY_MODEL_PATH=models/delay_model.joblib

# Scheduler: daily SLA/compliance checks run at DAILY_JOB_HOUR (in TZ_DISPLAY). Safe to leave on; alerts are deduplicated.
SCHEDULER_ENABLED=true
DAILY_JOB_HOUR=1
LOG_LEVEL=INFO
